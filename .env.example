APP_ENV=development
IDN_BASE_URL=https://www.idn.id
IDN_TRAINING_URL=https://www.idn.id/training/
KB_BASE_URL=https://kb.idn.id
KB_TRAINING_URL=https://kb.idn.id/kb/training
KB_TRAINING_CREATE_URL=https://kb.idn.id/kb/training/edit?new=1
DATABASE_PATH=data/idn_kb.db
HEADLESS=false
BROWSER_PROFILE_PATH=runtime/chrome-profile
LOG_LEVEL=INFO
CRAWL_TIMEOUT_SECONDS=30
CRAWL_DELAY_SECONDS=0.75
CRAWL_MAX_RETRIES=3
CRAWL_CONCURRENCY=2
CRAWLER_USER_AGENT=IDN-KB-Agent/0.2 (+local reconnaissance; respectful crawler)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_WEB_SEARCH_ENABLED=true
RESEARCH_MAX_SEARCHES_PER_PRODUCT=3
RESEARCH_MAX_RETRIES=3
RESEARCH_CONCURRENCY=2
RESEARCH_CACHE_DAYS=30
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=3
OLLAMA_CONCURRENCY=1
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_TEMPERATURE=0.2
OUTPUT_LANGUAGE=id-ID
BROWSER_RESEARCH_CONCURRENCY=1
HTTP_FETCH_CONCURRENCY=2
